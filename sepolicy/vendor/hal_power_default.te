# Powerhints
allow hal_power_default vendor_sysfs_msm_perf:dir r_dir_perms;
allow hal_power_default vendor_sysfs_msm_perf:file rw_file_perms;

allow hal_power_default vendor_sysfs_devfreq:dir r_dir_perms;
allow hal_power_default vendor_sysfs_devfreq:dir search;
allow hal_power_default vendor_sysfs_devfreq:{ file lnk_file } rw_file_perms;

allow hal_power_default vendor_sysfs_kgsl:dir search;
allow hal_power_default vendor_sysfs_kgsl:{ file lnk_file } rw_file_perms;

allow hal_power_default proc:file rw_file_perms;
